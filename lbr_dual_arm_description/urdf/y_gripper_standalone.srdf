<?xml version="1.0"?>
<!-- Minimal SRDF for y_gripper_standalone.xacro, matched against just its
lbr_one_link_7 stand-in flange + gripper links, not the full dual-arm
SRDF, whose arm_one/arm_two/etc. groups reference links this standalone
model doesn't have. -->
<robot name="y_gripper_standalone">
    <group name="lbr_one_gripper">
        <joint name="lbr_one_left_finger_joint" />
    </group>

    <group_state name="open" group="lbr_one_gripper">
        <joint name="lbr_one_left_finger_joint" value="0.04" />
    </group_state>
    <group_state name="closed" group="lbr_one_gripper">
        <joint name="lbr_one_left_finger_joint" value="0.0" />
    </group_state>

    <disable_collisions link1="lbr_one_link_7" link2="lbr_one_gripper_base_link" reason="Adjacent" />
    <disable_collisions link1="lbr_one_link_ee" link2="lbr_one_gripper_base_link" reason="Adjacent" />
    <disable_collisions link1="lbr_one_gripper_base_link" link2="lbr_one_left_finger_link" reason="Adjacent" />
    <disable_collisions link1="lbr_one_gripper_base_link" link2="lbr_one_right_finger_link" reason="Adjacent" />
</robot>
